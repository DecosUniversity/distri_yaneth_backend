@startuml iteracion2_estados
' Iteración 2 - Estados del lote / sub-lote de materia prima
skinparam shadowing false
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #4D4D4D
  ArrowColor #4D4D4D
  FontColor #000000
}

[*] --> Pendiente

state "Pendiente\n(lote por aceptar)" as Pendiente
state "Activo\n(sub-lote en maduración)" as EnProceso
state "Listo para producción" as Listo
state "Enviado a producción" as Enviado

Pendiente --> EnProceso : Se acepta el lote y se crea el\nsub-lote con su estado de madurez
Pendiente --> Listo : Lote aceptado como "Maduro"
EnProceso --> EnProceso : Muestreo periódico\n(Brix / Materia Seca)
EnProceso --> Listo : El sub-lote alcanza el\numbral técnico de Grados Brix
EnProceso --> Enviado : Sub-lote verde empacado en red\n(proceso de producción)
Listo --> Enviado : Su peso se consume en\nprocesos de producción
Enviado --> [*]

note left of EnProceso
  Un mismo lote puede fraccionarse en sub-lotes
  (verde, sarazo, maduro, sobremaduro); cada
  sub-lote avanza de estado de forma independiente.
end note

@enduml
