@startuml iteracion4_estados
' Iteración 4 - Estados del pedido
skinparam shadowing false
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #4D4D4D
  ArrowColor #4D4D4D
  FontColor #000000
}

[*] --> Pendiente

state "Pendiente" as Pendiente
state "Preparado" as Preparado
state "En Ruta" as EnRuta
state "Entregado" as Entregado
state "Con Devolución" as ConDevolucion
state "Cancelado" as Cancelado
state "Reingresado a Inventario" as Reingreso
state "Pérdida" as Perdida

Pendiente --> Preparado : Ruta asignada y\nmanifiesto generado
Pendiente --> Cancelado : Pedido cancelado
Preparado --> EnRuta : Piloto registra\nkilometraje de salida
EnRuta --> Entregado : Al cerrar la ruta, todas\nlas líneas fueron entregadas
EnRuta --> ConDevolucion : Al cerrar la ruta, alguna línea quedó\nparcial o rechazada (registra motivo)
ConDevolucion --> Reingreso : Recepción en bodega +\nresolución: producto reutilizable
ConDevolucion --> Perdida : Recepción en bodega +\nresolución: producto no reutilizable
Entregado --> [*]
Cancelado --> [*]
Reingreso --> [*]
Perdida --> [*]

note bottom of ConDevolucion
  La devolución se procesa por línea en dos pasos:
  1) recepción física en bodega
  2) resolución (reingreso a inventario o pérdida);
  la línea queda en estado "Devuelto".
end note

@enduml
